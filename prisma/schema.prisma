generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  password                  String
  name                      String?
  role                      String                   @default("owner")
  status                    String                   @default("active")
  company_id                String?
  email_verified_at         DateTime?
  created_at                DateTime                 @default(now())
  company                   Company?                 @relation(fields: [company_id], references: [id])
  tickets                   Ticket[]
  assigned_tickets          Ticket[]                 @relation("AssignedTickets")
  properties                Property[]
  comments                  TicketComment[]
  audit_logs                AuditLog[]
  password_reset_tokens     PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]
  team_invites_sent         TeamInvite[]
  assigned_work_orders      WorkOrder[]              @relation("AssignedWorkOrders")
  created_work_orders       WorkOrder[]              @relation("CreatedWorkOrders")
  managed_projects          Project[]                @relation("ManagedProjects")
  created_projects          Project[]                @relation("CreatedProjects")
  work_order_comments       WorkOrderComment[]
  project_comments          ProjectComment[]
  uploaded_documents        OperationalDocument[]    @relation("UploadedOperationalDocuments")
  created_leases            Lease[]                  @relation("CreatedLeases")
  work_order_checklist_items_created   WorkOrderChecklistItem[]  @relation("WorkOrderChecklistItemCreatedBy")
  work_order_checklist_items_completed WorkOrderChecklistItem[]  @relation("WorkOrderChecklistItemCompletedBy")
  work_order_edit_locks                WorkOrderEditLock[]
  work_order_execution_entries         WorkOrderExecutionEntry[]
  work_order_invoice_bases_created     WorkOrderInvoiceBasis[]    @relation("WorkOrderInvoiceBasisCreatedBy")
  work_order_invoice_bases_approved    WorkOrderInvoiceBasis[]    @relation("WorkOrderInvoiceBasisApprovedBy")
  work_order_reports_created           WorkOrderReport[]          @relation("WorkOrderReportCreatedBy")
  work_order_reports_approved          WorkOrderReport[]          @relation("WorkOrderReportApprovedBy")
  work_order_signatures                WorkOrderSignature[]
  work_order_status_events             WorkOrderStatusEvent[]
}

model Company {
  id                     String                @id @default(uuid())
  name                   String
  org_number             String?
  plan                   String                @default("professional")
  status                 String                @default("active")
  stripe_customer_id     String?
  stripe_subscription_id String?
  subscription_status    String?
  created_at             DateTime              @default(now())
  users                  User[]
  properties             Property[]
  tickets                Ticket[]
  audit_logs             AuditLog[]
  integration_events     IntegrationEvent[]
  team_invites           TeamInvite[]
  work_orders            WorkOrder[]
  projects               Project[]
  work_order_comments    WorkOrderComment[]
  project_comments       ProjectComment[]
  operational_documents  OperationalDocument[]
  lease_holders          LeaseHolder[]
  leases                 Lease[]
  work_order_checklist_items  WorkOrderChecklistItem[]
  work_order_edit_locks       WorkOrderEditLock[]
  work_order_execution_entries WorkOrderExecutionEntry[]
  work_order_invoice_bases    WorkOrderInvoiceBasis[]
  work_order_number_counters  WorkOrderNumberCounter[]
  work_order_reports          WorkOrderReport[]
  work_order_signatures       WorkOrderSignature[]
  work_order_status_events    WorkOrderStatusEvent[]
}

model Property {
  id                  String      @id @default(uuid())
  name                String
  address             String
  postal_code         String?
  city                String
  property_identifier String?
  property_type       String      @default("residential")
  status              String      @default("active")
  construction_year   Int?
  total_area          Float?
  boa                 Float?
  loa                 Float?
  manager_name        String?
  contact_name        String?
  contact_email       String?
  contact_phone       String?
  company_id          String?
  user_id             String
  created_at          DateTime    @default(now())
  updated_at          DateTime    @default(now()) @updatedAt
  company             Company?    @relation(fields: [company_id], references: [id])
  user                User        @relation(fields: [user_id], references: [id])
  tickets             Ticket[]
  buildings           Building[]
  units               Unit[]
  work_orders         WorkOrder[]
  projects            Project[]
  leases              Lease[]

  @@index([company_id])
  @@index([user_id])
  @@index([city])
}

model Building {
  id                String      @id @default(uuid())
  property_id       String
  name              String
  address           String?
  construction_year Int?
  floors            Int?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @default(now()) @updatedAt
  property          Property    @relation(fields: [property_id], references: [id], onDelete: Cascade)
  units             Unit[]
  work_orders       WorkOrder[]

  @@index([property_id])
}

model Unit {
  id          String      @id @default(uuid())
  property_id String
  building_id String?
  designation String
  unit_type   String      @default("apartment")
  floor       String?
  area        Float?
  rooms       Float?
  status      String      @default("active")
  created_at  DateTime    @default(now())
  updated_at  DateTime    @default(now()) @updatedAt
  property    Property    @relation(fields: [property_id], references: [id], onDelete: Cascade)
  building    Building?   @relation(fields: [building_id], references: [id], onDelete: SetNull)
  work_orders WorkOrder[]
  leases      Lease[]

  @@index([property_id])
  @@index([building_id])
  @@index([unit_type])
}

model Ticket {
  id                    String             @id @default(uuid())
  title                 String
  description           String
  status                String             @default("new")
  category              String             @default("other")
  priority              String             @default("normal")
  company_id            String?
  user_id               String
  property_id           String?
  assigned_to_id        String?
  public_reference      String?            @unique
  source                String             @default("internal")
  reporter_name         String?
  reporter_email        String?
  reporter_phone        String?
  reporter_unit         String?
  due_date              DateTime?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @default(now()) @updatedAt
  closed_at             DateTime?
  ai_summary            String?
  ai_recommended_action String?
  ai_confidence         Float?
  ai_processed_at       DateTime?
  company               Company?           @relation(fields: [company_id], references: [id])
  user                  User               @relation(fields: [user_id], references: [id])
  property              Property?          @relation(fields: [property_id], references: [id])
  assigned_to           User?              @relation("AssignedTickets", fields: [assigned_to_id], references: [id])
  comments              TicketComment[]
  attachments           TicketAttachment[]
  work_order            WorkOrder?
}

model WorkOrder {
  id                            String                    @id @default(uuid())
  company_id                    String
  ticket_id                     String?                   @unique
  property_id                   String
  building_id                   String?
  unit_id                       String?
  /// FK till PropertyTechnicalAsset i production; modell speglas i separat PR.
  technical_asset_id            String?
  assigned_to_id                String?
  created_by_id                 String
  title                         String
  description                   String
  notes                         String?
  status                        String                    @default("planned")
  priority                      String                    @default("normal")
  work_order_number             String?
  work_type                     String                    @default("corrective")
  source                        String                    @default("internal")
  scheduled_start               DateTime?
  scheduled_end                 DateTime?
  estimated_cost                Decimal?                  @db.Decimal(14, 2)
  actual_cost                   Decimal?                  @db.Decimal(14, 2)
  response_due_at               DateTime?
  completion_due_at             DateTime?
  sla_response_due_at           DateTime?
  sla_resolution_due_at         DateTime?
  responded_at                  DateTime?
  paused_at                     DateTime?
  pause_reason                  String?
  completed_at                  DateTime?
  closed_at                     DateTime?
  sla_status                    String                    @default("not_set")
  maintenance_cycle_key         String?
  maintenance_cycle_advanced_at DateTime?
  created_at                    DateTime                  @default(now())
  updated_at                    DateTime                  @default(now()) @updatedAt
  company                       Company                   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  ticket                        Ticket?                   @relation(fields: [ticket_id], references: [id], onDelete: SetNull)
  property                      Property                  @relation(fields: [property_id], references: [id], onDelete: Restrict)
  building                      Building?                 @relation(fields: [building_id], references: [id], onDelete: SetNull)
  unit                          Unit?                     @relation(fields: [unit_id], references: [id], onDelete: SetNull)
  assigned_to                   User?                     @relation("AssignedWorkOrders", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  created_by                    User                      @relation("CreatedWorkOrders", fields: [created_by_id], references: [id], onDelete: Restrict)
  projects                      Project[]
  comments                      WorkOrderComment[]
  documents                     OperationalDocument[]
  checklist_items               WorkOrderChecklistItem[]
  edit_lock                     WorkOrderEditLock?
  execution_entries             WorkOrderExecutionEntry[]
  invoice_bases                 WorkOrderInvoiceBasis[]
  reports                       WorkOrderReport[]
  signatures                    WorkOrderSignature[]
  status_events                 WorkOrderStatusEvent[]

  @@index([company_id, status])
  @@index([property_id])
  @@index([unit_id])
  @@index([assigned_to_id])
  @@index([scheduled_start])
  @@index([building_id])
  @@index([technical_asset_id])
  @@index([company_id, technical_asset_id, status], map: "WorkOrder_company_asset_status_idx")
  @@index([company_id, maintenance_cycle_advanced_at])
  @@index([company_id, sla_status])
  @@index([company_id, sla_resolution_due_at], map: "WorkOrder_company_sla_resolution_idx")
  @@index([company_id, sla_response_due_at], map: "WorkOrder_company_sla_response_idx")
  @@index([completion_due_at])
  @@index([response_due_at])
}

model Project {
  id                   String                @id @default(uuid())
  company_id           String
  property_id          String
  source_work_order_id String?
  manager_id           String?
  created_by_id        String
  name                 String
  description          String?
  status               String                @default("planned")
  risk                 String                @default("low")
  contractor           String?
  start_date           DateTime?
  end_date             DateTime?
  budget               Decimal               @default(0) @db.Decimal(14, 2)
  forecast             Decimal               @default(0) @db.Decimal(14, 2)
  actual               Decimal               @default(0) @db.Decimal(14, 2)
  created_at           DateTime              @default(now())
  updated_at           DateTime              @default(now()) @updatedAt
  completed_at         DateTime?
  company              Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  property             Property              @relation(fields: [property_id], references: [id], onDelete: Restrict)
  source_work_order    WorkOrder?            @relation(fields: [source_work_order_id], references: [id], onDelete: SetNull)
  manager              User?                 @relation("ManagedProjects", fields: [manager_id], references: [id], onDelete: SetNull)
  created_by           User                  @relation("CreatedProjects", fields: [created_by_id], references: [id], onDelete: Restrict)
  comments             ProjectComment[]
  documents            OperationalDocument[]

  @@index([company_id, status])
  @@index([property_id])
  @@index([source_work_order_id])
  @@index([manager_id])
  @@index([start_date])
}

model WorkOrderComment {
  id            String    @id @default(uuid())
  company_id    String
  work_order_id String
  user_id       String
  body          String
  is_internal   Boolean   @default(true)
  created_at    DateTime  @default(now())
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order    WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([company_id, work_order_id, created_at])
  @@index([user_id])
}

model WorkOrderChecklistItem {
  id              String    @id @default(uuid())
  company_id      String
  work_order_id   String
  created_by_id   String
  completed_by_id String?
  title           String
  description     String?
  is_required     Boolean   @default(true)
  sort_order      Int       @default(0)
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt
  company         Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order      WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  created_by      User      @relation("WorkOrderChecklistItemCreatedBy", fields: [created_by_id], references: [id], onDelete: Restrict)
  completed_by    User?     @relation("WorkOrderChecklistItemCompletedBy", fields: [completed_by_id], references: [id], onDelete: SetNull)

  @@index([company_id, work_order_id])
  @@index([work_order_id, sort_order])
}

model WorkOrderEditLock {
  work_order_id String    @id
  company_id    String
  user_id       String
  token_hash    String
  acquired_at   DateTime  @default(now())
  expires_at    DateTime
  updated_at    DateTime  @default(now()) @updatedAt
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  work_order    WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)

  @@index([company_id, expires_at])
  @@index([user_id])
}

model WorkOrderExecutionEntry {
  id            String    @id @default(uuid())
  company_id    String
  work_order_id String
  created_by_id String
  entry_type    String
  description   String
  quantity      Decimal   @default(1) @db.Decimal(14, 3)
  unit          String?
  unit_cost     Decimal?  @db.Decimal(14, 2)
  total_amount  Decimal   @default(0) @db.Decimal(14, 2)
  minutes       Int?
  distance_km   Decimal?  @db.Decimal(10, 2)
  supplier      String?
  occurred_at   DateTime  @default(now())
  created_at    DateTime  @default(now())
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order    WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  created_by    User      @relation(fields: [created_by_id], references: [id], onDelete: Restrict)

  @@index([company_id, work_order_id])
  @@index([occurred_at])
  @@index([work_order_id, entry_type])
}

model WorkOrderInvoiceBasis {
  id             String    @id @default(uuid())
  company_id     String
  work_order_id  String
  created_by_id  String
  status         String    @default("draft")
  reference      String    @unique
  currency       String    @default("SEK")
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  vat_rate       Decimal   @default(25) @db.Decimal(5, 2)
  vat_amount     Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  snapshot       Json
  approved_by_id String?
  approved_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  company        Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order     WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  created_by     User      @relation("WorkOrderInvoiceBasisCreatedBy", fields: [created_by_id], references: [id], onDelete: Restrict)
  approved_by    User?     @relation("WorkOrderInvoiceBasisApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)

  @@index([company_id, status])
}

model WorkOrderNumberCounter {
  company_id  String
  year        Int
  last_number Int      @default(0)
  updated_at  DateTime @default(now()) @updatedAt
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@id([company_id, year])
}

model WorkOrderReport {
  id             String    @id @default(uuid())
  company_id     String
  work_order_id  String
  created_by_id  String
  version        Int
  status         String    @default("draft")
  title          String
  snapshot       Json
  approved_by_id String?
  approved_at    DateTime?
  created_at     DateTime  @default(now())
  company        Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order     WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  created_by     User      @relation("WorkOrderReportCreatedBy", fields: [created_by_id], references: [id], onDelete: Restrict)
  approved_by    User?     @relation("WorkOrderReportApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)

  @@unique([work_order_id, version])
  @@index([company_id, work_order_id])
}

model WorkOrderSignature {
  id                String    @id @default(uuid())
  company_id        String
  work_order_id     String
  created_by_id     String
  signer_role       String
  signer_name       String
  signer_email      String?
  confirmation_text String
  signed_at         DateTime  @default(now())
  created_at        DateTime  @default(now())
  company           Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order        WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  created_by        User      @relation(fields: [created_by_id], references: [id], onDelete: Restrict)

  @@unique([work_order_id, signer_role])
  @@index([company_id, work_order_id])
}

model WorkOrderStatusEvent {
  id            String    @id @default(uuid())
  company_id    String
  work_order_id String
  actor_user_id String
  from_status   String?
  to_status     String
  reason        String?
  metadata      Json?
  created_at    DateTime  @default(now())
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order    WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  actor         User      @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([company_id, created_at], map: "WorkOrderStatusEvent_company_created_idx")
  @@index([work_order_id, created_at], map: "WorkOrderStatusEvent_work_order_created_idx")
}

model ProjectComment {
  id          String   @id @default(uuid())
  company_id  String
  project_id  String
  user_id     String
  body        String
  is_internal Boolean  @default(true)
  created_at  DateTime @default(now())
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([company_id, project_id, created_at])
  @@index([user_id])
}

model OperationalDocument {
  id             String     @id @default(uuid())
  company_id     String
  work_order_id  String?
  project_id     String?
  uploaded_by_id String
  file_name      String
  storage_url    String     @map("storage_key")
  content_type   String
  size_bytes     Int
  category       String     @default("other")
  visibility     String     @default("internal")
  version        Int        @default(1)
  created_at     DateTime   @default(now())
  company        Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  work_order     WorkOrder? @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  uploaded_by    User       @relation("UploadedOperationalDocuments", fields: [uploaded_by_id], references: [id], onDelete: Restrict)

  @@index([company_id, work_order_id, created_at])
  @@index([company_id, project_id, created_at])
  @@index([uploaded_by_id])
  @@index([storage_url])
}

model LeaseHolder {
  id                  String   @id @default(uuid())
  company_id          String
  party_type          String   @default("individual")
  name                String
  contact_name        String?
  email               String?
  phone               String?
  organization_number String?
  status              String   @default("active")
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt
  company             Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  leases              Lease[]

  @@index([company_id, name])
  @@index([company_id, email])
  @@index([company_id, status])
}

model Lease {
  id                   String      @id @default(uuid())
  company_id           String
  property_id          String
  unit_id              String
  lease_holder_id      String
  created_by_id        String
  lease_number         String
  status               String      @default("draft")
  start_date           DateTime?
  end_date             DateTime?
  notice_date          DateTime?
  monthly_rent         Decimal     @default(0) @db.Decimal(14, 2)
  deposit              Decimal     @default(0) @db.Decimal(14, 2)
  annual_index_percent Decimal     @default(0) @db.Decimal(7, 3)
  payment_terms_days   Int         @default(30)
  note                 String?
  ended_at             DateTime?
  created_at           DateTime    @default(now())
  updated_at           DateTime    @default(now()) @updatedAt
  company              Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  property             Property    @relation(fields: [property_id], references: [id], onDelete: Restrict)
  unit                 Unit        @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  lease_holder         LeaseHolder @relation(fields: [lease_holder_id], references: [id], onDelete: Restrict)
  created_by           User        @relation("CreatedLeases", fields: [created_by_id], references: [id], onDelete: Restrict)

  @@unique([company_id, lease_number])
  @@index([company_id, status])
  @@index([property_id])
  @@index([unit_id, status])
  @@index([lease_holder_id])
  @@index([start_date])
  @@index([end_date])
}

model TicketComment {
  id          String   @id @default(uuid())
  ticket_id   String
  user_id     String
  body        String
  is_internal Boolean  @default(false)
  created_at  DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticket_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticket_id    String
  file_name    String
  content_type String
  size_bytes   Int
  data_url     String
  visibility   String   @default("internal")
  created_at   DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticket_id], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  company_id    String?
  actor_user_id String?
  entity_type   String
  entity_id     String?
  action        String
  metadata      Json?
  created_at    DateTime @default(now())
  company       Company? @relation(fields: [company_id], references: [id])
  actor         User?    @relation(fields: [actor_user_id], references: [id])
}

model IntegrationEvent {
  id         String   @id @default(uuid())
  company_id String?
  type       String
  status     String   @default("mocked")
  recipient  String?
  payload    Json?
  created_at DateTime @default(now())
  company    Company? @relation(fields: [company_id], references: [id])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id])
}

model TeamInvite {
  id            String    @id @default(uuid())
  company_id    String
  invited_by_id String
  email         String
  name          String?
  role          String    @default("viewer")
  token_hash    String    @unique
  expires_at    DateTime
  accepted_at   DateTime?
  created_at    DateTime  @default(now())
  company       Company   @relation(fields: [company_id], references: [id])
  invited_by    User      @relation(fields: [invited_by_id], references: [id])
}

model RateLimitAttempt {
  id         String   @id @default(uuid())
  key_hash   String
  created_at DateTime @default(now())

  @@index([key_hash, created_at])
  @@index([created_at])
}
