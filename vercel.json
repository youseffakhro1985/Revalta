{
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/component-service-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/preventive-maintenance",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/service-assignment-escalations",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/invoice-export-jobs",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/recurring-work-orders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/recurring-incident-escalations",
      "schedule": "0 * * * *"
    }
  ]
}
