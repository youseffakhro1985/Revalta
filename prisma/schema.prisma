generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  name             String?
  role             String          @default("owner")
  status           String          @default("active")
  company_id       String?
  email_verified_at DateTime?
  created_at       DateTime        @default(now())
  company          Company?        @relation(fields: [company_id], references: [id])
  tickets          Ticket[]
  assigned_tickets Ticket[]        @relation("AssignedTickets")
  properties       Property[]
  comments         TicketComment[]
  audit_logs       AuditLog[]
  password_reset_tokens PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]
  team_invites_sent TeamInvite[]
}

model Company {
  id         String     @id @default(uuid())
  name       String
  org_number String?
  plan       String     @default("professional")
  status     String     @default("active")
  created_at DateTime   @default(now())
  users      User[]
  properties Property[]
  tickets    Ticket[]
  audit_logs AuditLog[]
  integration_events IntegrationEvent[]
  team_invites TeamInvite[]
}

model Property {
  id          String   @id @default(uuid())
  name        String
  address     String
  postal_code String?
  city        String
  company_id  String?
  user_id     String
  created_at  DateTime @default(now())
  company     Company? @relation(fields: [company_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
  tickets     Ticket[]
}

model Ticket {
  id             String          @id @default(uuid())
  title          String
  description    String
  status         String          @default("new")
  category       String          @default("other")
  priority       String          @default("normal")
  company_id     String?
  user_id        String
  property_id    String?
  assigned_to_id String?
  public_reference String?       @unique
  source         String          @default("internal")
  reporter_name  String?
  reporter_email String?
  reporter_phone String?
  reporter_unit  String?
  due_date       DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @default(now()) @updatedAt
  closed_at      DateTime?
  ai_summary     String?
  ai_recommended_action String?
  ai_confidence  Float?
  ai_processed_at DateTime?
  company        Company?        @relation(fields: [company_id], references: [id])
  user           User            @relation(fields: [user_id], references: [id])
  property       Property?       @relation(fields: [property_id], references: [id])
  assigned_to    User?           @relation("AssignedTickets", fields: [assigned_to_id], references: [id])
  comments       TicketComment[]
  attachments    TicketAttachment[]
}

model TicketComment {
  id          String   @id @default(uuid())
  ticket_id   String
  user_id     String
  body        String
  is_internal Boolean  @default(false)
  created_at  DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticket_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticket_id    String
  file_name    String
  content_type String
  size_bytes   Int
  data_url     String
  visibility    String   @default("internal")
  created_at   DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticket_id], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  company_id    String?
  actor_user_id String?
  entity_type   String
  entity_id     String?
  action        String
  metadata      Json?
  created_at    DateTime @default(now())
  company       Company? @relation(fields: [company_id], references: [id])
  actor         User?    @relation(fields: [actor_user_id], references: [id])
}

model IntegrationEvent {
  id         String   @id @default(uuid())
  company_id String?
  type       String
  status     String   @default("mocked")
  recipient  String?
  payload    Json?
  created_at DateTime @default(now())
  company    Company? @relation(fields: [company_id], references: [id])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model TeamInvite {
  id             String   @id @default(uuid())
  company_id     String
  invited_by_id  String
  email          String
  name           String?
  role           String   @default("viewer")
  token_hash     String   @unique
  expires_at     DateTime
  accepted_at    DateTime?
  created_at     DateTime @default(now())
  company        Company  @relation(fields: [company_id], references: [id])
  invited_by     User     @relation(fields: [invited_by_id], references: [id])
}
