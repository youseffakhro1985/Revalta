{
  "name": "revalta",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-build.mjs",
    "build:ci": "prisma generate && next build --webpack",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:dev": "prisma migrate dev",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "validate:release-config": "node scripts/validate-release-config.mjs",
    "assert:database-target": "node scripts/assert-database-target.mjs",
    "audit:prod": "npm audit --omit=dev",
    "audit:ui-interactions": "node scripts/audit-ui-interactions.mjs",
    "audit:dashboard-integrity": "node scripts/audit-dashboard-integrity.mjs",
    "quality": "npm run validate:release-config && npm run lint && npm run audit:ui-interactions && npm run audit:dashboard-integrity && npm run test:ci && npm run typecheck && npm run audit:prod && npm run build:ci",
    "postinstall": "prisma generate",
    "smoke:auth": "node scripts/smoke-auth-dashboard.mjs",
    "smoke:cron": "node scripts/smoke-cron.mjs",
    "smoke:ops": "node scripts/smoke-ops.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "jose": "^5.2.4",
    "lucide-react": "^1.14.0",
    "next": "16.3.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.2.2",
    "typescript": "^5"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.19",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@vercel/blob": {
      "undici": "6.28.1"
    },
    "brace-expansion@1.1.14": "1.1.18",
    "brace-expansion@5.0.5": "5.0.9",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "nanoid@3.3.16": "3.3.17",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    },
    "source-map-js@<1.2.2": "1.2.2"
  }
}
